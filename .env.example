# Copy to .env and adjust. All settings are prefixed PHRONEXUS_.
# Nested groups use __ as the delimiter.

PHRONEXUS_BACKEND=memory              # memory | aerospike

# --- Aerospike ---
PHRONEXUS_AEROSPIKE__HOSTS=127.0.0.1:3000
PHRONEXUS_AEROSPIKE__NAMESPACE=phronexus
PHRONEXUS_AEROSPIKE__USE_NATIVE_TXN=true
# TLS / mTLS
PHRONEXUS_AEROSPIKE__TLS_ENABLE=false
# PHRONEXUS_AEROSPIKE__TLS_CAFILE=/certs/ca.pem
# PHRONEXUS_AEROSPIKE__TLS_CERTFILE=/certs/client.pem
# PHRONEXUS_AEROSPIKE__TLS_KEYFILE=/certs/client.key

# --- Change feed (Kafka/Redpanda) ---
PHRONEXUS_KAFKA__ENABLED=false
PHRONEXUS_KAFKA__BOOTSTRAP_SERVERS=localhost:9092
PHRONEXUS_KAFKA__TOPIC_PREFIX=phronexus.commits

# --- Contract cache ---
PHRONEXUS_CONTRACTS__REFRESH_SECONDS=300
PHRONEXUS_CONTRACTS__BACKGROUND_REFRESH=false

# --- Observability ---
PHRONEXUS_OBSERVABILITY__LOG_LEVEL=INFO
PHRONEXUS_OBSERVABILITY__LOG_JSON=true
PHRONEXUS_OBSERVABILITY__OTEL_ENABLED=false
PHRONEXUS_OBSERVABILITY__OTEL_ENDPOINT=http://localhost:4317
